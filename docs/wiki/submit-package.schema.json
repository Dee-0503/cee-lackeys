{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cee.example/schemas/wiki-submit-package.v1.json",
  "title": "Desktop Wiki draft submission",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "operation_id", "wiki_id", "base_revision", "source", "changes"],
  "properties": {
    "schema": {"const": "lackeys.wiki-submit-package.v1"},
    "operation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "wiki_id": {"type": "string", "minLength": 1},
    "base_revision": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "actor"],
      "properties": {
        "kind": {"const": "desktop-draft"},
        "actor": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date-time"}
      }
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "action", "base_sha256", "content_sha256"],
        "properties": {
          "path": {"type": "string", "pattern": "^wiki/"},
          "action": {"enum": ["create", "replace", "delete"]},
          "base_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "content_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "content": {"type": ["string", "null"]}
        }
      }
    }
  }
}
